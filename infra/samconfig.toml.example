# AWS SAM Deployment Configuration Example
# Copy to samconfig.toml and customize parameters as needed.

version = 0.1

[default]
[default.global.parameters]
stack_name = "naive-sculpture-gallery"

[default.build.parameters]
cached = true
parallel = true

[default.validate.parameters]
lint = true

[default.deploy.parameters]
capabilities = "CAPABILITY_IAM"
confirm_changeset = true
resolve_s3 = true
s3_prefix = "naive-sculpture-gallery"
region = "eu-central-1"
parameter_overrides = [
  "Environment=\"prod\"",
  "ArtistNotificationEmail=\"artist@naive-sculptures.art\""
]
image_repositories = []

[default.package.parameters]
resolve_s3 = true

[default.sync.parameters]
watch = true

[default.local_start_api.parameters]
port = 8000
warm_containers = "EAGER"
